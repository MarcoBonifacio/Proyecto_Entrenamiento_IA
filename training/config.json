  "train_split_ratio": 0.8,
  "eval_split_ratio": 0.1,
  "test_split_ratio": 0.1,
  "seed": 42,
  "save_steps": 500,
  "eval_steps": 250,
  "logging_steps": 50,
  "fp16": false,
  "dataloader_num_workers": 0
}
